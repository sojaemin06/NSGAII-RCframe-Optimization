crosoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh wp14"><w:body><w:p w14:paraId="2BC1F353" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>[연구 요약 보고서] RC 프레임 최적화를 위한 하이브리드 치수-형상 프레임워크</w:t></w:r></w:p><w:p w14:paraId="4AA08B99" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>1. 서론 (Introduction)</w:t></w:r></w:p><w:p w14:paraId="0C183B43" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>연구 배경</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 학술적 최적화 알고리즘과 실제 건설 현장의 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>시공성</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 사이의 간극 존재. 특히 RC 프레임 설계는 경제성, 안전성, 탄소 중립성을 동시에 고려해야 하는 복잡한 다목적 최적화 문제(MOOP)임.</w:t></w:r></w:p><w:p w14:paraId="18A6222E" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>기존 연구의 한계</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 연속 변수 가정으로 인한 이산적 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>시공성</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 결여, 철근 배근의 비현실성, 기둥 회전 등 형상 변수 배제, 최적화 루프 내 과도한 사용성 검토로 인한 계산 효율 저하.</w:t></w:r></w:p><w:p w14:paraId="3879F1F6" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>연구 목적</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 실질적 시공성과 계산 효율성을 보장하는 </w:t></w:r><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>하이브리드 치수-형상 최적화 프레임워크</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 제안.</w:t></w:r></w:p><w:p w14:paraId="39444D80" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. 이론적 배경 (Theoretical Background)</w:t></w:r></w:p><w:p w14:paraId="0C5DE6E5" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>다목적 최적화 및 파레토 최적</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 상충하는 목적 함수들 사이의 균형점을 찾는 파레토 최적해 집합 도출을 목표로 함.</w:t></w:r></w:p><w:p w14:paraId="096F85EF" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>NSGA-II 알고리즘</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 빠른 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>비지배</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 정렬(Fast Non-dominated Sorting), 혼잡도 거리(Crowding Distance), 엘리트주의(Elitism) 전략을 통해 수렴성과 다양성을 동시에 확보하는 표준 알고리즘 활용.</w:t></w:r></w:p><w:p w14:paraId="1671D1C8" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>강도설계법(SDM) 및 제약 조건</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: ACI 318 및 ASCE 7 규정에 근거하여 극한한계상태(ULS)와 사용성한계상태(SLS)를 최적화의 제약 조건으로 설정.</w:t></w:r></w:p><w:p w14:paraId="2789A2BA" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>3. 제안된 최적화 프레임워크 (Proposed Framework)</w:t></w:r></w:p><w:p w14:paraId="66346E78" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2단계 프로세스</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>:</w:t></w:r></w:p><w:p w14:paraId="047ED494" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Stage 1 (DB 구축)</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 프로젝트 전용 이산 단면 데이터베이스를 사전 구축하여 계산 집약적인 사용성 검토를 최적화 루프에서 분리.</w:t></w:r></w:p><w:p w14:paraId="10ADE339" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Stage 2 (최적화)</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: Python(DEAP)과 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>OpenSees</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t>를 연동하여 NSGA-II 기반 최적화 수행.</w:t></w:r></w:p><w:p w14:paraId="79F2B0AF" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>핵심 혁신 요소</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>:</w:t></w:r></w:p><w:p w14:paraId="6E712581" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>하이브리드 변수</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 단면 치수(Size)와 기둥의 90도 회전 상태(Shape, 이진 변수)를 독립 설계 변수로 취급.</w:t></w:r></w:p><w:p w14:paraId="05B8B07D" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="4"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>제약 조건 관리</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: '제약 조건 지배 원리(Constraint-Dominance Principle)' 및 공학적 근거에 기반한 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>정규화된</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 위반 점수(CV score) 도입.</w:t></w:r></w:p><w:p w14:paraId="1957712C" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>4. 수치 예제 및 결과 분석 (Numerical Example &amp; Results)</w:t></w:r></w:p><w:p w14:paraId="4A9D5C95" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>대상 구조물</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 불규칙한 평면을 가진 8층 3D RC 모멘트 골조.</w:t></w:r></w:p><w:p w14:paraId="11F5916E" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>주요 결과</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>:</w:t></w:r></w:p><w:p w14:paraId="14D8DF83" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>파레토 프런트 도출</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 경제·환경 지표(Cost-Carbon)와 구조적 보수성(Stress Ratio) 사이의 명확한 반비례 관계 확인.</w:t></w:r></w:p><w:p w14:paraId="5F03610E" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>해석적 유효성</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 도출된 모든 최적해는 층간 변위 및 최상층 변위 제약 조건을 만족하였으며, 특히 풍하중이 단면 결정의 주요 인자로 작용함.</w:t></w:r></w:p><w:p w14:paraId="1FAF4655" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="1"/><w:numId w:val="5"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>대표 해 분석</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 경제적 해(Sol #1)는 재료 활용도를 극대화(</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>응력비</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 0.95 육박)하는 반면, 보수적 해(Sol #23)는 높은 안전 마진을 유지함.</w:t></w:r></w:p><w:p w14:paraId="2229E21A" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>5. 토론 및 검증 (Discussion &amp; Validation)</w:t></w:r></w:p><w:p w14:paraId="3BD3D444" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>알고리즘 신뢰성</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 독립적인 3회 반복 실험 결과, 최종 목적 함수 값의 편차가 2.1% 이내로 매우 높은 일관성과 재현성 입증.</w:t></w:r></w:p><w:p w14:paraId="4882FFDB" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>하이브리드 방식의 우월성</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 기둥 회전을 별도 변수로 분리한 방식이 단순히 단면 DB를 확장한 방식보다 </w:t></w:r><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>최적화 성능이 9% 이상 향상</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>됨을 정량적으로 검증.</w:t></w:r></w:p><w:p w14:paraId="649E5584" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>의사결정 지원</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 정량화된 파레토 프런트를 통해 건축주와 설계자 간의 합리적인 비용-성능 타협 가능.</w:t></w:r></w:p><w:p w14:paraId="29438471" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>6. 결론 및 향후 과제 (Conclusion)</w:t></w:r></w:p><w:p w14:paraId="1E3CB493" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>연구 성과</w:t></w:r><w:r w:rsidRPr="00300545"><w:t>: 시공 가능한 단면 기반의 하이브리드 최적화 모델 구축 및 구조적 보수성과 경제성 간의 트레이드오프 정량화.</w:t></w:r></w:p><w:p w14:paraId="19E836DC" w14:textId="77777777" w:rsidR="00300545" w:rsidRPr="00300545" w:rsidRDefault="00300545" w:rsidP="00300545"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr></w:pPr><w:r w:rsidRPr="00300545"><w:rPr><w:b/><w:bCs/></w:rPr><w:t>한계점 및 향후 연구</w:t></w:r><w:r w:rsidRPr="00300545"><w:t xml:space="preserve">: 균일한 </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00300545"><w:t>스터럽</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00300545"><w:t xml:space="preserve"> 간격의 최적화 필요, 철근 정착/이음 및 거푸집 비용의 상세 모델링, 부재 그룹화 전략의 자동화 연구 예정.</w:t></w:r></w:p><w:p w14:paraId="45C717FF" w14:textId="77777777" w:rsidR="008B26C5" w:rsidRPr="00300545" w:rsidRDefault="008B26C5"/><w:sectPr w:rsidR="008B26C5" w:rsidRPr="00300545"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1701" w:right="1440" w:bottom="1440" w:left="1440" w:header="851" w:footer="992" w:gutter="0"/><w:cols w:space="425"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>